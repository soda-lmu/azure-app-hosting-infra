# Copy to .env and fill in. .env is gitignored and holds every secret.

# --- Shared PostgreSQL server (shared/postgres) ---
SHARED_RG=rg-admin-appmanagment-shared-database-prod
LOCATION=germanywestcentral
PG_INSTANCE_NAME=pg-shared-CHANGEME   # server name, globally unique (host: <name>.postgres.database.azure.com)
PG_SKU=Standard_B1ms                  # Burstable; move to Standard_B2s when more apps join
PG_ENTRA_ADMIN_GROUP=pg-shared-admins # Entra group whose members administer the server
PG_ADMIN_USER=pgadmin                 # password admin, for tools without Entra login
PG_ADMIN_PASSWORD=                    # openssl rand -hex 24
PG_BACKUP_RETENTION_DAYS=14           # 7-35; point-in-time restore window

# --- GitHub environment secrets (litellm-production) ---
# !! KEEP IN SYNC: litellm-deploy.yml reads the following values from GitHub.
# (Settings -> Environments -> litellm-production -> Environment secrets). 
# After changing one here, change it there too, otherwise the next GitHub deploy reverts it. 
GITHUB_REPO=                          # owner/name; its "litellm-production" environment may deploy (empty: no CI) (not a secret, but convenient to have in .env)
PG_HOST=${PG_INSTANCE_NAME}.postgres.database.azure.com # derived; the GitHub secret holds the resolved value
AZURE_API_BASE=                       # Azure AI endpoint from existing resource, e.g. https://<resource>.openai.azure.com
AZURE_TENANT_ID=                      # az account show --query tenantId -o tsv
AZURE_SUBSCRIPTION_ID=                # az account show --query id -o tsv
LITELLM_GITHUB_DEPLOY_CLIENT_ID='<fill out later>' # client ID (a GUID) of id-github-deploy-litellm, not its name; printed by apps/litellm/deploy.sh after its first run


# --------------------------------------------------
# ---------------- Deploy Apps to Azure ------------
# --------------------------------------------------
# --- LiteLLM app (apps/litellm) ---
LITELLM_RG=rg-soda-litellm-prod       # environment + app (CI deploys here)
LITELLM_SECRETS_RG=rg-soda-litellm-secrets-prod # identity + Key Vault (admin-only)
LITELLM_ENV=cae-litellm
LITELLM_APP=litellm
LITELLM_IDENTITY=id-litellm           # managed identity LiteLLM runs as (Postgres login, Key Vault)
# Secrets: deploy.sh writes them to Key Vault when set. Afterwards they can be removed from here.
LITELLM_MASTER_KEY=                   # must start with sk-; e.g. sk-$(openssl rand -hex 24)
LITELLM_SALT_KEY=                     # openssl rand -hex 32. Set ONCE, never change: encrypts stored credentials

# Azure AI. Only for the local docker compose test. Wherever AZURE_API_KEY is set, LiteLLM uses the key and
# ignores the managed identity. deploy.sh doesn't pass it to Azure, so there id-litellm is used.
AZURE_API_KEY=
