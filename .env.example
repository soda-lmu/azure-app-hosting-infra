# Copy to .env and fill in. .env is gitignored and holds every secret.

# --- Shared PostgreSQL server (shared/postgres) ---
SHARED_RG=rg-shared-data
LOCATION=swedencentral
PG_SERVER=pg-shared-CHANGEME          # globally unique: <name>.postgres.database.azure.com
PG_SKU=Standard_B1ms                  # Burstable; move to Standard_B2s when more apps join
PG_ADMIN_USER=pgadmin
PG_ADMIN_PASSWORD=                    # openssl rand -hex 24

# --- LiteLLM app (apps/litellm) ---
LITELLM_RG=rg-litellm
LITELLM_ENV=cae-litellm
LITELLM_APP=litellm
LITELLM_DB_PASSWORD=                  # password of the per-app "litellm" role; openssl rand -hex 24
LITELLM_MASTER_KEY=                   # must start with sk-; e.g. sk-$(openssl rand -hex 24)

# Azure OpenAI
AZURE_API_BASE=
AZURE_API_KEY=
