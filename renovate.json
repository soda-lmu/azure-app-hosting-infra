{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "18 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container image in Bicep files (not a format Renovate knows natively)",
      "managerFilePatterns": ["/\\.bicep$/"],
      "matchStrings": ["image: '(?<depName>[^':]+):(?<currentValue>[\\w.-]+)'"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "LiteLLM: merged automatically once CI passes; the deploy workflow rolls it out",
      "matchPackageNames": ["ghcr.io/berriai/litellm-database"],
      "groupName": "litellm image",
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
