# Only for the local docker compose test (docker-compose.yml). Copy to .env in this directory
# (gitignored); compose reads it automatically. Deploys don't use it: they use config.sops.yaml.
# Azure AI endpoint, e.g. https://<resource>.openai.azure.com
AZURE_API_BASE=
# API key of that resource. Locally LiteLLM uses it instead of a managed identity.
AZURE_API_KEY=
